    function updateEvalBarAndCoach() {
        const curMove = currentMoveIndex > 0 ? reviewHistory[currentMoveIndex - 1] : null;
        const evalBarBlack = document.getElementById("evalBarBlack");
        const evalTextTop = document.getElementById("evalTextTop");
        const evalTextBottom = document.getElementById("evalTextBottom");
        const coachCard = document.getElementById("coachCard");
        const suggBox = document.getElementById("suggestionBox");

        if (!curMove) {
            evalBarBlack.style.height = "50%";
            evalTextTop.textContent = "";
            evalTextBottom.textContent = "+0.0";
            coachCard.style.display = "none";
            return;
        }

        let evalVal = (curMove.eval || 0) / 100;
        let blackPct = boardFlipped ? (50 + (evalVal * 8)) : (50 - (evalVal * 8));
        blackPct = Math.max(2, Math.min(98, blackPct));
        evalBarBlack.style.height = `${blackPct}%`;

        let formattedText = Math.abs(evalVal) >= 8.0 ? (evalVal > 0 ? "M" : "-M") : (evalVal > 0 ? `+${evalVal.toFixed(1)}` : evalVal.toFixed(1));

        if (evalVal >= 0) { evalTextTop.textContent = ""; evalTextBottom.textContent = formattedText; }
        else { evalTextTop.textContent = formattedText; evalTextBottom.textContent = ""; }

        coachCard.style.display = "flex";
        document.getElementById("coachTitle").textContent = curMove.coachTitle || "⭐ Best Move";
        document.getElementById("coachText").textContent = curMove.coachText || "You played the top engine move!";

        if (curMove.suggestedSAN && curMove.badge !== "⭐" && curMove.badge !== "!!") {
            suggBox.style.display = "flex";
