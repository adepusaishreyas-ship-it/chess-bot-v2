<script>
window.addEventListener('DOMContentLoaded', () => {
    const cdnBase = "https://www.chess.com/chess-themes/pieces/neo/150/";
    const pieceImages = {
        wK: cdnBase + "wk.png", wQ: cdnBase + "wq.png", wR: cdnBase + "wr.png", wB: cdnBase + "wb.png", wN: cdnBase + "wn.png", wP: cdnBase + "wp.png",
        bK: cdnBase + "bk.png", bQ: cdnBase + "bq.png", bR: cdnBase + "br.png", bB: cdnBase + "bb.png", bN: cdnBase + "bn.png", bP: cdnBase + "bp.png"
