    let lastMoveBot = null;

    let engine;
    function initEngine() {
        try {
            const workerCode = `importScripts('https://cdnjs.cloudflare.com/ajax/libs/stockfish.js/10.0.2/stockfish.js');`;
            const blob = new Blob([workerCode], { type: 'application/javascript' });
            engine = new Worker(URL.createObjectURL(blob));

            engine.onmessage = function(event) {
                const line = String(event.data || "").trim();
                if (line === "uciok") {
                    engine.postMessage("setoption name UCI_LimitStrength value true");
                    engine.postMessage("setoption name UCI_Elo value 2000");
                    engine.postMessage("isready");
                    return;
                }
                if (line === "readyok") {
                    engineReady = true;
                    updateStatus();
                    return;
                }
                if (line.startsWith("bestmove ")) {
                    const moveText = line.split(/\s+/)[1];
                    if (!thinking || !moveText) return;

                    setTimeout(() => {
                        try {
                            const played = game.move({
                                from: moveText.slice(0, 2),
                                to: moveText.slice(2, 4),
                                promotion: moveText.length >= 5 ? moveText[4] : undefined
                            });
                            if (played) lastMoveBot = { from: played.from, to: played.to };
                        } catch (e) {}

                        thinking = false;
                        selected = null;
                        validMoves = [];
                        drawBotBoard(game, boardEl, selected, validMoves, lastMoveBot, clickSquare);
                        updateStatus();
                    }, 800);
                }
            };
            engine.postMessage("uci");
        } catch(e) { engineReady = true; }
    }
    initEngine();

    function drawBotBoard(chessInstance, targetElement, selSquare, valMoves, lMove, clickCallback) {
        targetElement.innerHTML = "";
        const position = chessInstance.board();

        let rows = [0, 1, 2, 3, 4, 5, 6, 7];
        let cols = [0, 1, 2, 3, 4, 5, 6, 7];
        if (boardFlipped) { rows.reverse(); cols.reverse(); }

        for (let ri = 0; ri < 8; ri++) {
            for (let ci = 0; ci < 8; ci++) {
                const r = rows[ri];
                const c = cols[ci];
                const name = "abcdefgh"[c] + String(8 - r);
                const piece = position[r][c];

                const square = document.createElement("div");
                square.className = "sq " + ((r + c) % 2 === 0 ? "light" : "dark");

                if (ci === 0) {
                    const rLabel = document.createElement("span");
                    rLabel.className = "coord-rank";
                    rLabel.textContent = String(8 - r);
                    square.appendChild(rLabel);
                }
                if (ri === 7) {
                    const fLabel = document.createElement("span");
                    fLabel.className = "coord-file";
                    fLabel.textContent = "abcdefgh"[c];
                    square.appendChild(fLabel);
                }

                if (piece) {
                    const key = piece.color + piece.type.toUpperCase();
                    const pieceImg = document.createElement("img");
                    pieceImg.src = pieceImages[key];
                    pieceImg.draggable = false;
                    square.appendChild(pieceImg);
                }

                if (selSquare === name) square.classList.add("selected");
                if (lMove && (lMove.from === name || lMove.to === name)) square.classList.add("last-move-src");

                if (valMoves) {
                    const destination = valMoves.find(m => m.to === name);
                    if (destination) {
                        const marker = document.createElement("div");
                        marker.className = piece ? "capture-dot" : "dot";
                        square.appendChild(marker);
                    }
                }

                if (clickCallback) square.addEventListener("click", () => clickCallback(name));
                targetElement.appendChild(square);
            }
        }
    }

    function clickSquare(square) {
        if (thinking || game.game_over()) return;
        if (!isPassAndPlay && game.turn() !== userColor) return;

        const chosenMove = validMoves.find(m => m.to === square);
        if (selected && chosenMove) {
            const played = game.move({ from: selected, to: square, promotion: 'q' });
            if (played) lastMoveBot = { from: played.from, to: played.to };
            selected = null;
            validMoves = [];
            drawBotBoard(game, boardEl, selected, validMoves, lastMoveBot, clickSquare);
            updateStatus();

            if (!game.game_over() && !isPassAndPlay) requestBotMove();
            return;
        }

        const piece = game.get(square);
        if (piece && (isPassAndPlay ? piece.color === game.turn() : piece.color === userColor)) {
            selected = square;
            validMoves = game.moves({ square: square, verbose: true });
        } else {
            selected = null;
            validMoves = [];
        }
        drawBotBoard(game, boardEl, selected, validMoves, lastMoveBot, clickSquare);
    }

    function requestBotMove() {
        if (!engineReady || game.game_over() || isPassAndPlay || game.turn() === userColor) return;
