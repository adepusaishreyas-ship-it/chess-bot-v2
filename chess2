    document.getElementById("eloSelect").addEventListener("change", (e) => {
        if (engine && engineReady) engine.postMessage(`setoption name UCI_Elo value ${e.target.value}`);
    });

    // --- GAME REVIEW ENGINE & REPLAY SYSTEM ---
    const reviewGame = new Chess();
    const reviewBoardEl = document.getElementById("reviewBoard");
    let reviewHistory = [];
    let currentMoveIndex = 0;
    let autoPlayTimer = null;
    let parsedTokens = [];
    let editingTokenIndex = -1;

    function compressImageToCompressedBase64(file, maxDimension, quality) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (event) => {
                const img = new Image();
                img.src = event.target.result;
                img.onload = () => {
                    let w = img.width, h = img.height;
                    if (w > maxDimension || h > maxDimension) {
                        if (w > h) { h = Math.round((h * maxDimension) / w); w = maxDimension; }
                        else { w = Math.round((w * maxDimension) / h); h = maxDimension; }
                    }
                    const canvas = document.createElement("canvas");
                    canvas.width = w; canvas.height = h;
                    const ctx = canvas.getContext("2d");
                    ctx.drawImage(img, 0, 0, w, h);
                    const dataUrl = canvas.toDataURL("image/jpeg", quality);
                    resolve(dataUrl.split(",")[1]);
                };
                img.onerror = reject;
            };
            reader.onerror = reject;
        });
    }

    // AI Vision OCR Handler with Gemini API
    document.getElementById("ocrFileInput").addEventListener("change", async function() {
        const file = this.files[0];
        if (!file) return;

        const statusDiv = document.getElementById("ocrStatus");
        const userApiKey = "AQ.Ab8RN6L_1jNpjJiKzorU9Pa6jaxF_AltpPhywnYa39sHZ8bBDw";

        statusDiv.style.color = "#81b64c";
        statusDiv.textContent = "⚡ Optimizing image & scanning notation...";

        try {
            const compressedBase64Bytes = await compressImageToCompressedBase64(file, 1000, 0.8);
            const candidateModels = ["gemini-3.5-flash-lite", "gemini-3.8-flash", "gemini-3.5-flash"];
            let extractedPgn = null;

            for (const modelName of candidateModels) {
                try {
                    statusDiv.textContent = `🧠 Scanning via ${modelName}...`;
                    const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${userApiKey}`;

                    const requestBody = {
                        contents: [{
                            parts: [
                                { text: "Extract chess moves sequentially into standard algebraic PGN format. Extract player names if listed at top into headers e.g. [White \"Name\"] [Black \"Name\"]. Translate handwritten notation into valid SAN. Return ONLY clean PGN text without extra quotes or commentary." },
                                { inline_data: { mime_type: "image/jpeg", data: compressedBase64Bytes } }
                            ]
                        }],
                        generationConfig: { temperature: 0.1, maxOutputTokens: 1000 }
                    };

                    const response = await fetch(API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(requestBody)
                    });

                    const data = await response.json();
                    if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
                        extractedPgn = data.candidates[0].content.parts[0].text.trim();
                        break;
                    }
                } catch(e) {}
            }

            if (extractedPgn) {
                document.getElementById("pgnInput").value = extractedPgn;
                statusDiv.textContent = "✅ Notation extracted successfully!";
                processAndRenderPgn();
            } else {
                statusDiv.style.color = "#ff5555";
                statusDiv.textContent = "❌ OCR extraction failed. Please paste PGN manually.";
            }
        } catch(err) {
            statusDiv.style.color = "#ff5555";
            statusDiv.textContent = "❌ Error processing scorecard photo.";
        }
    });

    function drawReviewBoard() {
        reviewBoardEl.innerHTML = "";
        const position = reviewGame.board();
        const curMove = currentMoveIndex > 0 ? reviewHistory[currentMoveIndex - 1] : null;

        let rows = [0, 1, 2, 3, 4, 5, 6, 7];
        let cols = [0, 1, 2, 3, 4, 5, 6, 7];
        if (boardFlipped) { rows.reverse(); cols.reverse(); }

        for (let ri = 0; ri < 8; ri++) {
            for (let ci = 0; ci < 8; ci++) {
                const r = rows[ri];
                const c = cols[ci];
                const name = "abcdefgh"[c] + String(8 - r);
                const piece = position[r][c];

                const square = document.createElement("div");
                square.className = "sq " + ((r + c) % 2 === 0 ? "light" : "dark");

