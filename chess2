    // CAPS2 Win Probability Formula (0.0 to 1.0)
    function winPercent(cp) {
        return 1.0 / (1.0 + Math.pow(10.0, -cp / 400.0));
    }

    // Stockfish Web Worker Integration
    let evalEngine;
    function initEvalEngine() {
        try {
            const workerCode = `importScripts('https://cdnjs.cloudflare.com/ajax/libs/stockfish.js/10.0.2/stockfish.js');`;
            const blob = new Blob([workerCode], { type: 'application/javascript' });
            evalEngine = new Worker(URL.createObjectURL(blob));
            evalEngine.postMessage("uci");
        } catch(e) {}
    }
    initEvalEngine();

    function evaluatePosition(fen, sideToMove) {
        return new Promise((resolve) => {
            if (!evalEngine) return resolve({ eval: 0, bestSAN: null, bestSq: null });

            let bestSAN = null, bestSq = null, rawEval = 0;
            let handler = (e) => {
                const line = String(e.data || "");
                if (line.includes("score cp")) {
                    const parts = line.split(" ");
                    const cpIdx = parts.indexOf("cp");
                    if (cpIdx !== -1) rawEval = parseInt(parts[cpIdx + 1]);
                } else if (line.includes("score mate")) {
                    const parts = line.split(" ");
                    const mateIdx = parts.indexOf("mate");
                    if (mateIdx !== -1) {
                        let m = parseInt(parts[mateIdx + 1]);
                        rawEval = m > 0 ? 10000 - m * 10 : -10000 - m * 10;
                    }
                }
                if (line.startsWith("bestmove")) {
                    const parts = line.split(" ");
                    if (parts[1]) {
                        bestSq = parts[1].slice(2, 4);
                        bestSAN = parts[1];
                    }
                    evalEngine.removeEventListener("message", handler);
                    resolve({ eval: sideToMove === 'w' ? rawEval : -rawEval, bestSAN, bestSq });
                }
            };
            evalEngine.addEventListener("message", handler);
            evalEngine.postMessage("position fen " + fen);
            evalEngine.postMessage("go depth 14");
        });
    }

    // Exact Move Classification Matrix Matching Backend Logic
    function classifyMove(boardBefore, move, cpl, isTopMove, isBook, cpBefore, cpAfter) {
        const movingPiece = boardBefore.piece_at(move.from);
        const capturedPiece = boardBefore.piece_at(move.to);
        const isCapture = capturedPiece !== null;
        const pieceValues = { p: 1, n: 3, b: 3, r: 5, q: 9, k: 0 };
        const isSacrifice = isCapture && movingPiece && capturedPiece && (pieceValues[movingPiece.type] > pieceValues[capturedPiece.type]);

        if (isBook) {
            return { key: "book", label: "Book", badge: "📖", bgClass: "badge-bg-book", title: "Book Move", text: "Standard opening book theory." };
        }
        if (isSacrifice && (isTopMove || cpl <= 15) && cpAfter >= -100) {
            return { key: "brilliant", label: "Brilliant", badge: "!!", bgClass: "badge-bg-brilliant", title: "Brilliant Move !!", text: "A magnificent sacrifice maintaining or improving evaluation!" };
        }
        if (!isTopMove && cpl <= 10 && cpBefore < 200 && cpAfter >= 250) {
            return { key: "great", label: "Great Move", badge: "!", bgClass: "badge-bg-great", title: "Great Move !", text: "A critical find that secures significant advantage." };
        }
        if (isTopMove || cpl === 0) {
            return { key: "best", label: "Best Move", badge: "⭐", bgClass: "badge-bg-best", title: "Best Move", text: "You played the top engine recommendation!" };
        }
        if (cpl <= 15) {
            return { key: "excellent", label: "Excellent", badge: "👍", bgClass: "badge-bg-excellent", title: "Excellent Move", text: "Very close to the best engine line." };
        }
        if (cpl <= 50) {
            return { key: "good", label: "Good", badge: "✓", bgClass: "badge-bg-good", title: "Good Move", text: "Sub-optimal but maintains game balance." };
        }
        if (cpl <= 100) {
            return { key: "inaccuracy", label: "Inaccuracy", badge: "?", bgClass: "badge-bg-inaccuracy", title: "Inaccuracy ?", text: "Minor mistake that drops evaluation slightly." };
        }
        if (cpl <= 300) {
            return { key: "mistake", label: "Mistake", badge: "??", bgClass: "badge-bg-mistake", title: "Mistake ??", text: "Significant error shifting the game balance." };
        }
        if (cpBefore - cpAfter > 200 && !isTopMove) {
            return { key: "miss", label: "Miss", badge: "❌", bgClass: "badge-bg-miss", title: "Missed Opportunity ❌", text: "Failing to capitalize on tactical opportunities." };
        }
        return { key: "blunder", label: "Blunder", badge: "???", bgClass: "badge-bg-blunder", title: "Blunder ???", text: "Catastrophic mistake drastically changing win probability." };
    }

    async function processAndRenderPgn() {
        const rawPgn = document.getElementById("pgnInput").value.trim();
        if (!rawPgn) return;

        const analysisStatusText = document.getElementById("analysisStatusText");
        analysisStatusText.textContent = "⏳ Deep Engine Analysis...";

        reviewGame.reset();
        reviewHistory = [];
        parsedTokens = [];

        const whiteMatch = rawPgn.match(/\[White\s+"([^"]+)"\]/i);
        const blackMatch = rawPgn.match(/\[Black\s+"([^"]+)"\]/i);
        document.getElementById("whitePlayerNameDisplay").textContent = whiteMatch ? whiteMatch[1] : "White";
        document.getElementById("blackPlayerNameDisplay").textContent = blackMatch ? blackMatch[1] : "Black";

        const cleanMovesText = rawPgn.replace(/\[.*?\]/g, "").replace(/\{.*?\}/g, "").trim();
        const moveRegex = /(?:(\d+)\.\s*)?([a-zA-O-Q-R-K-N1-8x+#=\-]+)/g;
        let match;
        let tempGame = new Chess();
        let moveSequence = [];

        while ((match = moveRegex.exec(cleanMovesText)) !== null) {
            const num = match[1];
            const san = match[2];
            if (!san || san === "1-0" || san === "0-1" || san === "1/2-1/2") continue;

            const res = tempGame.move(san, { sloppy: true });
            if (res) {
                moveSequence.push({ num, san, res, fen: tempGame.fen() });
            } else {
                parsedTokens.push({ num, san, isError: true });
            }
        }

        let stats = {
            w: { brilliant: 0, great: 0, best: 0, excellent: 0, good: 0, book: 0, inaccuracy: 0, mistake: 0, miss: 0, blunder: 0, accList: [] },
            b: { brilliant: 0, great: 0, best: 0, excellent: 0, good: 0, book: 0, inaccuracy: 0, mistake: 0, miss: 0, blunder: 0, accList: [] }
        };

        let moveCount = 0;
        let boardBeforeEval = new Chess();

        for (let i = 0; i < moveSequence.length; i++) {
            const item = moveSequence[i];
            const color = item.res.color;
            analysisStatusText.textContent = `Analyzing move ${i+1}/${moveSequence.length}...`;

            const evalBeforeRes = await evaluatePosition(boardBeforeEval.fen(), color);
            const cpBefore = evalBeforeRes.eval;

            boardBeforeEval.move(item.san, { sloppy: true });
            const evalAfterRes = await evaluatePosition(boardBeforeEval.fen(), color);
            const cpAfter = evalAfterRes.eval;

            const cpl = Math.max(0, cpBefore - cpAfter);
            const isTopMove = evalBeforeRes.bestMove === (item.res.from + item.res.to + (item.res.promotion || ''));
            const isBook = i < 10 && cpl <= 5 && isTopMove;

            const classification = classifyMove(reviewGame, item.res, cpl, isTopMove, isBook, cpBefore, cpAfter);

            let res = item.res;
            res.eval = cpAfter;
            res.evalClass = "last-move-src";
            res.badge = classification.badge;
            res.badgeBgClass = classification.bgClass;
            res.coachTitle = classification.title;
            res.coachText = classification.text;
            res.suggestedSAN = evalRes.bestSAN || item.san;
            res.bestSq = evalRes.bestMove ? evalRes.bestMove.slice(2, 4) : null;

            // CAPS2 Win Probability Delta & Exponential Decay Accuracy Score
            const wpBefore = winProbability(cpBefore);
            const wpAfter = winProbability(cpAfter);
            const wpLoss = Math.max(0, wpBefore - wpAfter);
            
            let moveAcc = 100.0 * Math.exp(-4.0 * wpLoss);
            stats[color].accList.push(moveAcc);
            stats[color][classification.key]++;

            reviewHistory.push(res);
            parsedTokens.push({ num: item.num, san: item.san, isError: false, moveIndex: ++moveCount });
        }

        analysisStatusText.textContent = "Analysis Complete ✓";
        renderTokenFlow(parsedTokens);

        ['w', 'b'].forEach(clr => {
            const prefix = clr === 'w' ? 'White' : 'Black';
            ['Brilliant', 'Great', 'Best', 'Excellent', 'Good', 'Book', 'Inaccuracy', 'Mistake', 'Miss', 'Blunder'].forEach(k => {
                document.getElementById(`cnt${prefix}${k}`).textContent = stats[clr][k.toLowerCase()];
            });
            const avgAcc = stats[clr].accList.length ? (stats[clr].accList.reduce((a,b)=>a+b,0)/stats[clr].accList.length) : 90.0;
            document.getElementById(`${clr === 'w' ? 'white' : 'black'}Acc`).textContent = avgAcc.toFixed(1) + "%";
            document.getElementById(`${clr === 'w' ? 'white' : 'black'}Rating`).textContent = Math.floor(1500 + avgAcc * 5);
        });

        renderEvaluationGraph();
        jumpToMove(0);
    }

    function renderEvaluationGraph() {
        const canvas = document.getElementById("evalGraphCanvas");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const w = canvas.width = canvas.parentElement.clientWidth;
        const h = canvas.height = canvas.parentElement.clientHeight;

        ctx.clearRect(0, 0, w, h);
        ctx.fillStyle = "#21201d";
        ctx.fillRect(0, 0, w, h);

        ctx.strokeStyle = "#383531";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, h / 2);
        ctx.lineTo(w, h / 2);
        ctx.stroke();

        if (reviewHistory.length === 0) return;

        ctx.strokeStyle = "#81b64c";
        ctx.lineWidth = 2;
        ctx.beginPath();

        const step = w / Math.max(1, reviewHistory.length - 1);
        reviewHistory.forEach((m, idx) => {
            const x = idx * step;
            const evalVal = (m.eval || 0) / 100;
            const y = (h / 2) - (evalVal * (h / 10));
            const clampedY = Math.max(4, Math.min(h - 4, y));

            if (idx === 0) ctx.moveTo(x, clampedY);
            else ctx.lineTo(x, clampedY);
        });
        ctx.stroke();
    }

    function openEditModal(tokenIdx, currentSan) {
        editingTokenIndex = tokenIdx;
        document.getElementById("modalContextText").textContent = `Edit Move Token #${tokenIdx + 1}:`;
        document.getElementById("editMoveInput").value = currentSan;
        document.getElementById("editModal").style.display = "flex";
    }

    document.getElementById("cancelMoveEditBtn").addEventListener("click", () => {
        document.getElementById("editModal").style.display = "none";
    });

    document.getElementById("saveMoveEditBtn").addEventListener("click", () => {
        const newVal = document.getElementById("editMoveInput").value.trim();
        if (newVal && editingTokenIndex >= 0 && parsedTokens[editingTokenIndex]) {
            parsedTokens[editingTokenIndex].san = newVal;

            let reconstructed = "";
            parsedTokens.forEach((t) => {
                reconstructed += `${t.num ? t.num + "." : ""} ${t.san} `;
            });
            document.getElementById("pgnInput").value = reconstructed;
            document.getElementById("editModal").style.display = "none";
            processAndRenderPgn();
        }
    });

    document.getElementById("loadPgnBtn").addEventListener("click", processAndRenderPgn);

    document.getElementById("btnFirst").addEventListener("click", () => jumpToMove(0));
    document.getElementById("btnPrev").addEventListener("click", () => {
        if (currentMoveIndex > 0) jumpToMove(currentMoveIndex - 1);
    });
    document.getElementById("btnNext").addEventListener("click", () => {
        if (currentMoveIndex < reviewHistory.length) jumpToMove(currentMoveIndex + 1);
    });
    document.getElementById("btnLast").addEventListener("click", () => jumpToMove(reviewHistory.length));

    document.getElementById("btnAutoPlay").addEventListener("click", function() {
        if (autoPlayTimer) {
            clearInterval(autoPlayTimer);
            autoPlayTimer = null;
            this.textContent = "Start Review ▶";
        } else {
            this.textContent = "Pause Review ⏸";
            autoPlayTimer = setInterval(() => {
                if (currentMoveIndex < reviewHistory.length) {
                    jumpToMove(currentMoveIndex + 1);
                } else {
                    clearInterval(autoPlayTimer);
                    autoPlayTimer = null;
                    document.getElementById("btnAutoPlay").textContent = "Start Review ▶";
                }
            }, 1200);
        }
    });

    window.addEventListener('keydown', (e) => {
        const activeTag = document.activeElement.tagName.toLowerCase();
        if (activeTag === 'input' || activeTag === 'textarea') return;

        if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) {
            e.preventDefault();
            if (e.key === 'ArrowLeft' && currentMoveIndex > 0) jumpToMove(currentMoveIndex - 1);
            if (e.key === 'ArrowRight' && currentMoveIndex < reviewHistory.length) jumpToMove(currentMoveIndex + 1);
            if (e.key === 'Home') jumpToMove(0);
            if (e.key === 'End') jumpToMove(reviewHistory.length);
        } else if (e.key.toLowerCase() === 'x') {
            e.preventDefault();
            boardFlipped = !boardFlipped;
            drawBotBoard(game, boardEl, selected, validMoves, lastMoveBot, clickSquare);
            drawReviewBoard();
        }
    });

    window.addEventListener("resize", renderEvaluationGraph);
});
</script>
